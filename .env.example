# =================================================================
# DocuChat - Environment Variables Configuration Template
# Copy this file to .env and fill in your credentials.
# =================================================================

# Google Gemini API key obtained from Google AI Studio (https://aistudio.google.com/)
GOOGLE_API_KEY=" your_gemini_api_key_here"
# Primary Gemini LLM model for grounded question answering
LLM_MODEL=gemini-3.6-flash

# Gemini Embedding model for vector indexing and semantic retrieval
EMBEDDING_MODEL=gemini-embedding-001

# Character size for each document chunk during ingestion
CHUNK_SIZE=800

# Number of overlapping characters between consecutive chunks
CHUNK_OVERLAP=100

# Number of top relevant chunks to retrieve from Chroma for context
TOP_K=4

# Maximum allowed upload file size in megabytes (MB)
MAX_UPLOAD_MB=20

# Directory path for temporarily staging uploaded PDF documents
UPLOAD_DIR=uploads

# Directory path for persistent Chroma vector database storage
CHROMA_DIR=chroma_db
